<?xml version='1.0' encoding='utf-8'?>
<widget id="com.mitotalplayer.app" version="1.0.0" xmlns="http://www.cordova.io/ns/1.0" xmlns:android="http://schemas.android.com/apk/res/android">
    <name>Mi Total Player</name>
    <description>Reproductor Unificado de TV, Música y Radio</description>
    <author email="dev@mitotalplayer.com">Mi Total Player</author>
    
    <content src="index.html" />
    <access origin="*" />
    <allow-navigation href="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />

    <!-- ICONO PRINCIPAL DE LA APP -->
    <icon src="icon.png" />

    <!-- PREFERENCIAS DE PANTALLA COMPLETA Y NOTCH -->
    <preference name="Fullscreen" value="true" />
    <preference name="HideKeyboardFormAccessoryBar" value="true" />
    <preference name="StatusBarOverlaysWebView" value="true" />
    <preference name="StatusBarBackgroundColor" value="#000000" />
    <preference name="KeepRunning" value="true" />

    <!-- PLUGINS NATIVOS CORDOVA -->
    <plugin name="cordova-plugin-file" spec="~8.0.0" />
    <plugin name="cordova-plugin-statusbar" spec="~3.0.0" />
    <plugin name="cordova-plugin-fullscreen" spec="~1.3.0" />

    <platform name="android">
        <allow-intent href="market:*" />
        
        <!-- ICONOS DE ANDROID POR DENSIDAD -->
        <icon src="icon.png" density="ldpi" />
        <icon src="icon.png" density="mdpi" />
        <icon src="icon.png" density="hdpi" />
        <icon src="icon.png" density="xhdpi" />
        <icon src="icon.png" density="xxhdpi" />
        <icon src="icon.png" density="xxxhdpi" />
        
        <!-- PERMISOS DE ALMACENAMIENTO PARA /MiMusica -->
        <config-file target="AndroidManifest.xml" parent="/manifest">
            <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
            <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
            <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
            <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
        </config-file>
    </platform>
</widget>
